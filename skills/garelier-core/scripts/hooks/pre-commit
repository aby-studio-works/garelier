#!/bin/sh
# Garelier PM commit guard (DEC-075 follow-up). Installed by
# install_pm_commit_guard.sh into a project's MAIN worktree .git/hooks/
# pre-commit (a pre-existing project hook is preserved as pre-commit.local and
# chained first). git runs this UNCONDITIONALLY before every commit on the main
# worktree, so it mechanically prevents the two recurring PM-commit incidents the
# manual checklist kept missing:
#   1. MISPLACE — a PM commit landing on a role branch because the main worktree
#      was left checked out on workbench/* (HEAD is not an integration /studio
#      branch). This caused real damage (PM commits rode workbench/#16).
#   2. RACE / ABSORB — any non-gate commit while a merge gate holds active.lock,
#      INCLUDING one made while the gate's own `git merge --no-commit` is staged
#      in this shared index: without this guard that commit ABSORBS the gate's
#      in-flight merge into itself (a 2-parent merge commit under the wrong
#      message), emptying MERGE_HEAD so the gate finds no merge at its commit
#      step and aborts (the W-055 incident).
#
# It NEVER blocks:
#   - a LINKED worktree (worker/scout/etc) — those commit on role branches;
#   - the merge gate committing its OWN merge (GARELIER_MERGE_GATE_COMMIT=1, set
#     by merge-gate.sh) — the marker distinguishes the gate's commit from a
#     foreign commit that merely happens to land while MERGE_HEAD is present;
#   - a standalone user merge when NO merge gate lock is present;
#   - when GARELIER_ALLOW_NONSTUDIO_COMMIT=1 (one-off override);
#   - when [setup] commit_guard = "off" (or "warn" downgrades block to a warning)
#     — EXCEPT the W-055 absorb case (a foreign commit made while the gate's
#     merge is staged in the shared index): it has no safe outcome, so it is
#     HARD-blocked regardless of guard mode.
#
# Generic: integration branches end in /studio by Garelier convention
# (dispatch_prepare enforces it); the lock path is __garelier/<pm>/runtime/
# merge_gate/locks/. Remove .git/hooks/pre-commit to disable (pre-commit.local,
# if present, can be restored).

# 0. Chain a preserved pre-existing hook (e.g. check_assets) FIRST.
HOOK_SELF="$0"
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$HOOK_SELF")" && pwd)
if [ -x "$HOOK_DIR/pre-commit.local" ]; then
  "$HOOK_DIR/pre-commit.local" "$@" || exit $?
elif [ -f "$HOOK_DIR/pre-commit.local" ]; then
  sh "$HOOK_DIR/pre-commit.local" "$@" || exit $?
fi

# 1. Resolve worktree + apply the one-off override and guard mode to BOTH the
#    main worktree and linked (producer) worktrees. A LINKED worktree has a .git
#    FILE (a gitdir: pointer); the main worktree has a .git DIRECTORY.
TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

[ "${GARELIER_ALLOW_NONSTUDIO_COMMIT:-}" = "1" ] && exit 0

# Is a merge staged in THIS worktree right now (MERGE_HEAD present)? Used to tell
# a plain race-commit from one that would ABSORB the gate's in-flight merge.
# A present MERGE_HEAD is NOT by itself an exemption (W-055) — only the gate's
# own commit marker (GARELIER_MERGE_GATE_COMMIT) exempts, because a foreign
# commit can land while the gate's MERGE_HEAD is staged in the shared index.
MERGE_HEAD_PATH=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null || echo "")
MERGING=0
{ [ -n "$MERGE_HEAD_PATH" ] && [ -f "$MERGE_HEAD_PATH" ]; } && MERGING=1

# 1a. ABSORB hard-block (W-055) — evaluated BEFORE guard mode, so it fires even
#     in warn/off. In the PRIMARY worktree (shared index with the gate), a
#     non-gate commit made while a merge gate holds active.lock AND its
#     `git merge --no-commit` is staged here (MERGING=1) would ABSORB that
#     in-flight merge into itself and strand the gate at its commit step. There
#     is no safe outcome for such a commit, so — unlike the mode-tunable guards
#     below — it is ALWAYS refused unless THIS is the gate committing its own
#     merge (GARELIER_MERGE_GATE_COMMIT=1). A linked worktree has its own index
#     and cannot absorb the primary's merge, so it is not covered here.
if [ ! -f "$TOPLEVEL/.git" ] && [ "$MERGING" -eq 1 ] && [ "${GARELIER_MERGE_GATE_COMMIT:-}" != "1" ]; then
  for lock in "$TOPLEVEL"/__garelier/*/runtime/merge_gate/locks/active.lock; do
    [ -f "$lock" ] || continue
    echo "pre-commit BLOCKED (garelier commit guard): a merge gate holds active.lock and a merge is in progress in this shared worktree — committing now would ABSORB the gate's in-flight merge into this commit and strand the gate at its commit step (W-055). Refused regardless of commit_guard mode. Wait for the gate (it commits its own merge with GARELIER_MERGE_GATE_COMMIT=1); if the lock is stale, remove it or use GARELIER_ALLOW_NONSTUDIO_COMMIT=1." >&2
    exit 1
  done
fi

# 2. Guard mode from the first project setup_config (block | warn | off; default block).
MODE=block
for cfg in "$TOPLEVEL"/__garelier/*/_pm/setup_config.toml; do
  [ -f "$cfg" ] || continue
  m=$(sed -n 's/^[[:space:]]*commit_guard[[:space:]]*=[[:space:]]*"\([a-z]*\)".*/\1/p' "$cfg" | head -1)
  [ -n "$m" ] && MODE="$m"
  break
done
[ "$MODE" = "off" ] && exit 0

VIOL=""
HEAD_REF=$(git symbolic-ref -q --short HEAD 2>/dev/null || echo "<detached>")

if [ -f "$TOPLEVEL/.git" ]; then
  # LINKED worktree (producer: Worker/Smith/Librarian/Artisan). It commits on its
  # OWN role branch and must NEVER commit on studio — that bypasses the
  # workbench→Guardian→Observer→merge path (#4 producer-checkout misplace, DEC-088).
  # Anything else on a linked worktree is legitimate and unguarded.
  case "$HEAD_REF" in
    */studio) [ "$MERGING" -eq 0 ] && VIOL="a producer worktree is on '$HEAD_REF' (studio) — producers commit on their own workbench/anvil/shelf/satchel branch, never studio; cut/switch to the role branch (misplace guard)" ;;
    *) exit 0 ;;
  esac
else
  # 3. MISPLACE guard — on the primary worktree HEAD must be an integration branch.
  case "$HEAD_REF" in
    */studio) : ;;
    *) VIOL="HEAD is '$HEAD_REF', not an integration (*/studio) branch — refusing a commit on a non-studio branch in the main worktree (misplace guard)" ;;
  esac

  # 4. RACE guard — a plain (non-merge) commit while a merge gate holds
  #    active.lock. The MERGING=1 ABSORB case is already hard-blocked above (1a),
  #    so MERGING is 0 here; the gate's own merge commit (MERGING=1, marker set)
  #    never reaches this guard.
  if [ -z "$VIOL" ] && [ "$MERGING" -eq 0 ] && [ "${GARELIER_MERGE_GATE_COMMIT:-}" != "1" ]; then
    for lock in "$TOPLEVEL"/__garelier/*/runtime/merge_gate/locks/active.lock; do
      [ -f "$lock" ] || continue
      VIOL="a merge gate lock is present ($lock) and no merge is in progress in this worktree — refusing a commit during an in-flight merge (race guard); if the lock is stale, remove it or use the override"
      break
    done
  fi
fi

[ -z "$VIOL" ] && exit 0

if [ "$MODE" = "warn" ]; then
  echo "pre-commit WARNING (garelier commit guard): $VIOL" >&2
  exit 0
fi
echo "pre-commit BLOCKED (garelier commit guard): $VIOL" >&2
echo "  override once: GARELIER_ALLOW_NONSTUDIO_COMMIT=1 git commit ...   (or [setup] commit_guard = \"warn\"/\"off\")" >&2
exit 1
