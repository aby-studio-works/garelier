#!/usr/bin/env bash
#
# garelier — self-locating dispatcher for bundled Garelier scripts.
#
# WHY THIS EXISTS
#   A Claude Code plugin adds this `bin/` directory to the Bash-tool PATH, so the
#   model (or a human) can run `garelier <subcommand> [args...]` from ANY working
#   directory. The relative `../garelier-<skill>/scripts/...` paths in the skill
#   docs only resolve when *reading* a doc — not when the Bash tool runs a script,
#   because the Bash-tool cwd is the user's project, not the doc's directory.
#   (Empirically confirmed: `${CLAUDE_PLUGIN_ROOT}` is NOT a shell env var and is
#   NOT substituted in skill/reference prose — see DEC-053.)
#
#   This wrapper resolves the plugin/checkout root from $0 (the file physically
#   lives in the cache / checkout), maps a subcommand to the bundled script, and
#   execs it with the remaining args untouched.
#
# DEV (symlink) INSTALL
#   `install.ts` symlinks skills into ~/.claude/skills/ but does NOT touch PATH.
#   To get the `garelier` command in dev mode, add `<checkout>/bin` to your PATH:
#     export PATH="<checkout>/bin:$PATH"
#   Plugin installs do this automatically.

set -euo pipefail

# --- self-locate the plugin/checkout root (this file is <root>/bin/garelier) ---
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do                       # resolve a chain of symlinks (dev)
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
SKILLS="$ROOT/skills"

print_help() {
  cat <<'EOF'
garelier <subcommand> [args...] — run a bundled Garelier script from any cwd.

Setup / scaffolding:
  setup                 PM setup wizard            (garelier-pm/setup_wizard.ts)
  crust-init            init Plant-Crust layout    (garelier-pm/crust_init.ts)
  control-init          init a control project     (garelier-control-project/init_control.ts)
  control-split         split a control project    (garelier-control-project/split_control.ts)
  control-consolidate   consolidate controls       (garelier-control-project/consolidate_controls.ts)
  library-init          init a knowledge library   (garelier-control-library/init_library.ts)
  install-hooks         install git hooks          (garelier-core/install_hooks.ts)
  install-main-guards   install commit/rebase/push guards into a TARGET project's main worktree (garelier-core/install_pm_commit_guard.ts; DEC-075/088)
  install-concierge-guards  install push guards    (garelier-core/install_concierge_guards.ts)

Run / operate (dispatch-only, DEC-061/066):
  status                pipeline status            (dock_status.ts; add --format json for agent use)
  status-web            start the status web       (garelier-core/start_status.ts)
  stop-status           stop the status web        (garelier-core/stop_status.ts)
  doctor                health checks              (garelier-core/doctor.ts)
  dispatch-prepare      cut a producer worktree    (garelier-core/dispatch_prepare.ts)
  dispatch-cleanup      remove a producer worktree (garelier-core/dispatch_cleanup.ts)
  dispatch-event        record event + regen view  (garelier-core/dispatch_event.ts)
  merge-request         one-command merge request  (garelier-core/merge_request.ts)
  merge-gate            run the merge gate         (garelier-core/merge-gate.ts)
  retro-digest          lessons-learned digest     (garelier-core/retro_digest.ts)
  session-digest        emit a session digest      (garelier-core/session_digest.ts)
  scheduler-adapter     scheduled-jobs adapter     (garelier-core/scheduler_adapter.ts)
  request-intake        request intake handler     (garelier-core/request_intake_handler.ts)
  plant-resolve         show Plant mode/roots      (garelier-core/plant.ts resolve)
  plant-validate        validate Plant resolution  (garelier-core/plant.ts resolve)
  plant-containers      list Crust containers      (garelier-core/plant.ts list-containers)
  plant-workfolder-validate validate Crust registry (garelier-core/plant.ts validate-workfolder)
  plant-add-container   add a Crust container      (garelier-core/plant.ts add-container)
  plant-write-lock      write a Crust lock         (garelier-core/plant.ts write-lock)
  plant-lock-validate   validate container lock    (garelier-core/plant.ts validate-lock)
  plant-crust-validate  validate crust.toml        (garelier-core/plant.ts validate-crust)
  lens-validate         validate Lens registry     (garelier-core/lenses.ts validate-registry)
  lens-defaults         show default Lens set      (garelier-core/lenses.ts defaults)
  lens-parse-blueprint  parse blueprint Lens refs  (garelier-core/lenses.ts parse-blueprint)

Import / export:
  control-export        export control state       (garelier-pm/control_export.ts)
  control-import        import control state       (garelier-pm/control_import.ts)
  knowledge-export      export knowledge           (garelier-librarian/knowledge_export.ts)
  knowledge-import      import knowledge           (garelier-librarian/knowledge_import.ts)

Graphs (bun):
  control-graph         control graph              (garelier-core/control_graph.ts)
  knowledge-graph       knowledge graph            (garelier-core/knowledge_graph.ts)

Escape hatch:
  exec <relpath> [args] run any script by its path relative to the plugin root
  help                  show this help

All args after the subcommand are passed through unchanged.
EOF
}

sub="${1:-help}"
[ $# -gt 0 ] && shift

#
# W-083 Wave D flip: every bundled subcommand script is now a bun/TS twin, so
# this dispatcher execs the .ts DIRECTLY (no `exec bash <name>.ts` double-shim).
# The TypeScript files are the only CLI entrypoints.
case "$sub" in
  # setup / scaffolding
  setup)                    exec bun "$SKILLS/garelier-core/driver/src/scripts/setup_wizard.ts" "$@" ;;
  crust-init)               exec bun "$SKILLS/garelier-pm/scripts/crust_init.ts" "$@" ;;
  control-init)             exec bun "$SKILLS/garelier-control-project/scripts/init_control.ts" "$@" ;;
  control-split)            exec bun "$SKILLS/garelier-control-project/scripts/split_control.ts" "$@" ;;
  control-consolidate)      exec bun "$SKILLS/garelier-control-project/scripts/consolidate_controls.ts" "$@" ;;
  library-init)             exec bun "$SKILLS/garelier-control-library/scripts/init_library.ts" "$@" ;;
  install-hooks)            exec bun "$SKILLS/garelier-core/driver/src/scripts/install_hooks.ts" "$@" ;;
  install-main-guards)      exec bun "$SKILLS/garelier-core/driver/src/scripts/install_pm_commit_guard.ts" "$@" ;;
  install-concierge-guards) exec bun "$SKILLS/garelier-core/driver/src/scripts/install_concierge_guards.ts" "$@" ;;

  # run / operate (dispatch-only; the driver/stop-driver routes were removed
  # with the headless driver, DEC-066)
  dispatch-prepare)         exec bun "$SKILLS/garelier-core/driver/src/scripts/dispatch_prepare.ts" "$@" ;;
  dispatch-cleanup)         exec bun "$SKILLS/garelier-core/driver/src/scripts/dispatch_cleanup.ts" "$@" ;;
  dispatch-event)           exec bun "$SKILLS/garelier-core/driver/src/scripts/dispatch_event.ts" "$@" ;;
  merge-request)            exec bun "$SKILLS/garelier-core/driver/src/scripts/merge_request.ts" "$@" ;;
  status)                   exec bun "$SKILLS/garelier-core/driver/src/dispatch/dock_status.ts" "$@" --format text ;;
  status-web|start-status)  exec bun "$SKILLS/garelier-core/driver/src/scripts/status_web_cli.ts" start "$@" ;;
  stop-status)              exec bun "$SKILLS/garelier-core/driver/src/scripts/status_web_cli.ts" stop "$@" ;;
  doctor)                   exec bun "$SKILLS/garelier-core/driver/src/scripts/doctor.ts" "$@" ;;
  merge-gate)
    exec bun "$SKILLS/garelier-core/driver/src/scripts/merge-gate.ts" "$@"
    ;;
  retro-digest)             exec bun "$SKILLS/garelier-core/scripts/retro_digest.ts" "$@" ;;
  session-digest)           exec bun "$SKILLS/garelier-core/driver/src/scripts/session_digest.ts" "$@" ;;
  scheduler-adapter)        exec bun "$SKILLS/garelier-core/driver/src/scripts/scheduler_adapter.ts" "$@" ;;
  request-intake)           exec bun "$SKILLS/garelier-core/driver/src/scripts/request_intake_handler.ts" "$@" ;;
  plant-resolve)            exec bun "$SKILLS/garelier-core/driver/src/plant.ts" resolve "$@" ;;
  plant-validate)           exec bun "$SKILLS/garelier-core/driver/src/plant.ts" resolve "$@" ;;
  plant-containers)         exec bun "$SKILLS/garelier-core/driver/src/plant.ts" list-containers "$@" ;;
  plant-workfolder-validate) exec bun "$SKILLS/garelier-core/driver/src/plant.ts" validate-workfolder "$@" ;;
  plant-add-container)      exec bun "$SKILLS/garelier-core/driver/src/plant.ts" add-container "$@" ;;
  plant-write-lock)         exec bun "$SKILLS/garelier-core/driver/src/plant.ts" write-lock "$@" ;;
  plant-lock-validate)      exec bun "$SKILLS/garelier-core/driver/src/plant.ts" validate-lock "$@" ;;
  plant-crust-validate)     exec bun "$SKILLS/garelier-core/driver/src/plant.ts" validate-crust "$@" ;;
  lens-validate)            exec bun "$SKILLS/garelier-core/driver/src/lenses.ts" validate-registry "$@" ;;
  lens-defaults)            exec bun "$SKILLS/garelier-core/driver/src/lenses.ts" defaults "$@" ;;
  lens-parse-blueprint)     exec bun "$SKILLS/garelier-core/driver/src/lenses.ts" parse-blueprint "$@" ;;

  # import / export
  control-export)           exec bun "$SKILLS/garelier-pm/scripts/control_export.ts" "$@" ;;
  control-import)           exec bun "$SKILLS/garelier-pm/scripts/control_import.ts" "$@" ;;
  knowledge-export)         exec bun "$SKILLS/garelier-librarian/scripts/knowledge_export.ts" "$@" ;;
  knowledge-import)         exec bun "$SKILLS/garelier-librarian/scripts/knowledge_import.ts" "$@" ;;

  # graphs (bun)
  control-graph)            exec bun "$SKILLS/garelier-core/scripts/control_graph.ts" "$@" ;;
  knowledge-graph)          exec bun "$SKILLS/garelier-core/scripts/knowledge_graph.ts" "$@" ;;

  # escape hatch + help
  exec)
    rel="${1:?usage: garelier exec <relpath> [args]}"; shift
    case "$rel" in
      *.ts) exec bun  "$ROOT/$rel" "$@" ;;
      *)    exec bash "$ROOT/$rel" "$@" ;;
    esac
    ;;
  help|-h|--help)           print_help ;;
  *)
    echo "garelier: unknown subcommand '$sub'" >&2
    echo "" >&2
    print_help >&2
    exit 2
    ;;
esac
