# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Local backups (created by install.ts on conflict)
*.bak
*.bak.*
*.tmp

# Test installs
.test_install/

# Logs
*.log

# Garelier transient state (persistent control remains tracked)
__garelier/*/runtime/
__garelier/*/_dispatch*/
__garelier/*/_wanderers/
# W-621 [TX-4]: a control transaction stages a whole copy of the control tree in
# `.control.txn-<random>/` beside the control root. It is removed on commit or
# rollback, but a crashed or interrupted transaction leaves one behind — one sat
# for 13 hours. Being a dotfile it is invisible to `ls` while showing as `??` in
# `git status`, so `git add -A` would commit a duplicate of the whole control
# tree. Never tracked, whatever else is decided about reclaiming it.
__garelier/*/.control.txn-*/
# showcase/ is the transient deliverable drop-zone (retention.md § Showcase,
# W-085): gitignored like runtime/. gallery/ is its TRACKED curated sibling and
# is intentionally NOT ignored.
__garelier/*/showcase/
.worktrees/
